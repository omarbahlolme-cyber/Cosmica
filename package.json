{
  "name": "cosmica",
  "version": "1.1.0",
  "description": "Cosmica language worlds site with Miri chat backend",
  "main": "backend/server.js",
  "scripts": {
    "start": "node server.js",
    "generate:translations": "node scripts/generate-translations.js",
    "generate:romanization": "node scripts/generate-world-romanization.js",
    "generate:native-grammar": "node scripts/generate-native-grammar-cards.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "html:baseline": "node scripts/apply-html-baseline.js",
    "smoke": "node scripts/smoke.js",
    "smoke:checkout:cross-device": "node scripts/smoke-checkout-cross-device.js",
    "smoke:premium:continuity": "node scripts/smoke-premium-continuity.js",
    "verify:viewport": "node scripts/verify-viewport-matrix.js",
    "verify:viewport:browsers": "playwright install chromium firefox webkit",
    "indexing:check": "node scripts/indexing-followup.js",
    "rollback:info": "node scripts/rollback-info.js",
    "check:syntax": "node --check server.js && node --check backend/server.js && node --check frontend/app.js && node --check frontend/maps/app-maps.js",
    "check:literal-escapes": "node scripts/check-literal-escapes.js",
    "check:a11y": "node scripts/check-accessibility-baseline.js",
    "check:seo": "node scripts/generate-sitemap.js && node scripts/check-seo-baseline.js",
    "check:assets": "node scripts/check-asset-version-consistency.js",
    "check:html-cache": "node scripts/check-html-cache-policy.js",
    "check:integrity": "node scripts/check-external-integrity.js",
    "check:securitytxt": "node scripts/check-security-txt.js",
    "check:intents": "node scripts/check-world-phrase-intents.js",
    "check:worlds:deep": "node scripts/check-world-content-deep.js",
    "check:grammar:zero": "node scripts/check-grammar-zero-tolerance.js",
    "check:grammar:peer": "node scripts/check-grammar-peer-review.js",
    "check:grammar:lock": "node scripts/check-grammar-section-lock.js",
    "check:grammar:zero:pre-modifiers": "node scripts/check-grammar-zero-tolerance.js --before-section Modifiers",
    "check:grammar:zero:modifiers": "node scripts/check-grammar-zero-tolerance.js --sections Modifiers",
    "check:grammar:zero:questions": "node scripts/check-grammar-zero-tolerance.js --sections Questions",
    "check:grammar:zero:negation": "node scripts/check-grammar-zero-tolerance.js --sections Negation",
    "check:grammar:zero:connections": "node scripts/check-grammar-zero-tolerance.js --sections Connections",
    "check:grammar:zero:conditions": "node scripts/check-grammar-zero-tolerance.js --sections Conditions",
    "check:grammar:zero:voice": "node scripts/check-grammar-zero-tolerance.js --sections \"Voice & Focus\"",
    "check:grammar:zero:modality": "node scripts/check-grammar-zero-tolerance.js --sections Modality",
    "check:grammar:zero:reported": "node scripts/check-grammar-zero-tolerance.js --sections \"Reported Speech\"",
    "check:grammar:zero:formality": "node scripts/check-grammar-zero-tolerance.js --sections \"Formality & Style\"",
    "check:grammar:zero:discourse": "node scripts/check-grammar-zero-tolerance.js --sections \"Discourse & Flow\"",
    "check:grammar:zero:completed": "npm run check:grammar:zero:pre-modifiers && npm run check:grammar:zero:modifiers && npm run check:grammar:zero:questions && npm run check:grammar:zero:negation && npm run check:grammar:zero:connections && npm run check:grammar:zero:conditions && npm run check:grammar:zero:voice && npm run check:grammar:zero:modality && npm run check:grammar:zero:reported && npm run check:grammar:zero:formality && npm run check:grammar:zero:discourse",
    "check:grammar:peer:completed": "node scripts/check-grammar-peer-review.js",
    "check:grammar:strict:completed": "node scripts/check-grammar-section-lock.js",
    "check:grammar:zero:completed:extra": "npm run check:grammar:strict:completed && node --check frontend/maps/app-maps.js && node scripts/check-world-content-deep.js",
    "check:bloat": "node scripts/check-bloat.js",
    "check:bloat:refresh": "node scripts/check-bloat.js --write-allowlist",
    "perf:baseline": "node scripts/perf-snapshot.js --write",
    "perf:check": "node scripts/perf-check.js",
    "security:audit": "node scripts/security-audit-check.js",
    "security:live": "node scripts/live-security-check.js",
    "auth:check:readiness": "node scripts/check-auth-readiness.js",
    "auth:user:lifecycle": "node scripts/check-user-lifecycle.js",
    "auth-backup:create": "node scripts/create-auth-data-backup.js",
    "auth-backup:verify": "node scripts/verify-auth-data-backup.js",
    "auth-backup:restore": "node scripts/restore-auth-data-backup.js",
    "premium:repair:stripe": "node scripts/repair-premium-from-stripe.js",
    "premium:reconcile:stripe": "node scripts/reconcile-premium-with-stripe.js",
    "admin:grant:premium": "node scripts/grant-premium.js",
    "billing:contract": "node scripts/billing-contract-check.js",
    "billing:user-state:contract": "node scripts/user-state-contract-check.js",
    "auth:provider:contract": "node scripts/auth-provider-contract-check.js",
    "test:user-matrix": "node scripts/e2e-user-matrix.js",
    "github:harden": "node scripts/apply-github-hardening.js",
    "backup:create": "node scripts/create-backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "release:check": "node scripts/check-release.js",
    "quality": "npm run check:syntax && npm run check:literal-escapes && npm run check:a11y && npm run check:seo && npm run check:assets && npm run check:html-cache && npm run check:integrity && npm run check:securitytxt && npm run check:intents && npm run check:worlds:deep && npm run check:bloat && npm run perf:check && npm run security:audit && npm run release:check && npm run smoke && npm run billing:user-state:contract",
    "verify:pc-mobile": "npm run check:syntax && npm run smoke && npm run smoke:checkout:cross-device && npm run smoke:premium:continuity",
    "verify:prod-integrations": "node scripts/verify-prod-integrations.js",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\""
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "nodemailer": "^7.0.11",
    "openai": "^6.22.0",
    "pg": "^8.16.3",
    "stripe": "^20.3.1"
  },
  "overrides": {
    "minimatch": "10.2.2",
    "glob": "13.0.6",
    "rimraf": "6.1.3"
  }
}
