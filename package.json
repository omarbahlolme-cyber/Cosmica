{
  "name": "cosmica",
  "version": "1.1.0",
  "description": "Cosmica language worlds site with Miri chat backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "generate:translations": "node scripts/generate-translations.js",
    "smoke": "node scripts/smoke.js",
    "check:syntax": "node --check server.js && node --check app.js && node --check app-maps.js",
    "check:bloat": "node scripts/check-bloat.js",
    "perf:baseline": "node scripts/perf-snapshot.js --write",
    "perf:check": "node scripts/perf-check.js",
    "release:check": "node scripts/check-release.js",
    "quality": "npm run check:syntax && npm run check:bloat && npm run perf:check && npm run release:check && npm run smoke",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^6.9.13",
    "openai": "^4.62.0"
  }
}
