# Copy this file to .env and fill in values.
# PowerShell: Copy-Item .env.example .env

# Server
PORT=3000
NODE_ENV=development

# Stripe (required for Stripe premium mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PREMIUM_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional Stripe checkout labels/paths
STRIPE_PREMIUM_LABEL=Monthly
STRIPE_PREMIUM_DESCRIPTION=€9.99 per month
STRIPE_PREMIUM_SUCCESS_PATH=/index.html?premium=success
STRIPE_PREMIUM_CANCEL_PATH=/index.html?premium=cancel
STRIPE_PREMIUM_TRIAL_DAYS=0

# Optional smoke-test credentials
SMOKE_AUTH_EMAIL=
SMOKE_AUTH_PASSWORD=
SMOKE_EXPECTED_PREMIUM_URL=http://127.0.0.1:3000/api/billing/premium/checkout/start?option=monthly

# Auth store + premium continuity guardrails
AUTH_STORE_FAIL_FAST_ON_LOAD_ERROR=true
PREMIUM_CONTINUITY_CANARY_INTERVAL_MS=3600000
