# Copy this file to .env and fill in real values.
# PowerShell: Copy-Item .env.example .env

# ============================================================================
# CORE SERVER
# ============================================================================
PORT=3000
NODE_ENV=development
PUBLIC_APP_ORIGIN=http://127.0.0.1:3000

# ============================================================================
# AUTH / SECURITY BASICS
# Required in production.
# ============================================================================
ADMIN_SECURITY_TOKEN=replace_me_with_long_random_value
AUTH_PASSWORD_ITERATIONS=210000
EMAIL_VERIFICATION_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=7200000

# Optional but recommended for alerts.
AUTH_ALERT_WEBHOOK_URL=
ERROR_WEBHOOK_URL=
RUM_WEBHOOK_URL=

# ============================================================================
# EMAIL DELIVERY (choose one provider, or configure both)
# ============================================================================
# Resend
RESEND_API_KEY=
AUTH_FROM=

# SMTP fallback
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FEEDBACK_FROM=

# ============================================================================
# GOOGLE OAUTH (optional)
# Set both client id and secret if enabled.
# ============================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional explicit callback URL.
GOOGLE_OAUTH_REDIRECT_URI=

# ============================================================================
# BILLING - STRIPE (recommended)
# ============================================================================
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_LABEL=Monthly
STRIPE_PREMIUM_DESCRIPTION=EUR 9.99 per month
STRIPE_PREMIUM_SUCCESS_PATH=/index.html?premium=success
STRIPE_PREMIUM_CANCEL_PATH=/index.html?premium=cancel
STRIPE_PREMIUM_TRIAL_DAYS=0

# ============================================================================
# BILLING - KO-FI fallback (optional)
# ============================================================================
KOFI_PREMIUM_MONTHLY_URL=
KOFI_WEBHOOK_VERIFICATION_TOKEN=
KOFI_PREMIUM_OPTIONS_JSON=

# ============================================================================
# AI SERVICES (optional by feature)
# ============================================================================
OPENAI_API_KEY=
GOOGLE_TTS_ENABLED=false
GOOGLE_TTS_CREDENTIALS_B64=

# ============================================================================
# TEST / SMOKE OVERRIDES (optional)
# ============================================================================
SMOKE_AUTH_EMAIL=
SMOKE_AUTH_PASSWORD=
SMOKE_EXPECTED_PREMIUM_URL=http://127.0.0.1:3000/api/billing/premium/checkout/start?option=monthly

# ============================================================================
# DATA SAFETY / OPERATIONS
# ============================================================================
AUTH_STORE_FAIL_FAST_ON_LOAD_ERROR=true
PREMIUM_CONTINUITY_CANARY_INTERVAL_MS=3600000
